<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Trace"
      internalLogFile="c:Logs\internal_logs\internallog.txt">

	<targets>
		<target name="logfile" xsi:type="File"
				fileName="c:/Logs/${shortdate}_logfile_Code_Competition.txt"
				layout="${longdate} ${level:uppercase=true} ${message}"/>
		<target name="debugger" xsi:type="Debugger"
				layout="${level}>${message} (${exception:format=ToString})"/>
		<target name="console" xsi:type="ColoredConsole"
				layout="${date:format=dd-MM-yyyy HH\:mm\:ss} {level:uppercase=true} - ${message}" />
	</targets>

	<rules>
		<logger name="*" minlevel="Info" writeTo="logfile" />
		<logger name="*" minlevel="Error" writeTo="console" />
		<logger name="*" minlevel="Error" writeTo="debugger" />
	</rules>
</nlog>